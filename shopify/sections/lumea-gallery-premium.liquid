{% render 'lumea-styles' %}

<section class="lumea-premium lm-gallery lm-section">
  <style>
    .lm-gallery__head{max-width:640px;margin:0 auto 56px;text-align:center;}
    .lm-gallery__grid{
      display:grid;grid-template-columns:repeat(2,1fr);gap:18px;
    }
    @media (min-width:760px){
      .lm-gallery__grid{grid-template-columns:repeat(4,1fr);grid-auto-rows:220px;gap:22px;}
      .lm-gallery__grid .lm-scene{aspect-ratio:auto;height:100%;}
      .lm-gallery__cell:nth-child(6n+1){grid-column:span 2;grid-row:span 2;}
      .lm-gallery__cell:nth-child(6n+4){grid-row:span 2;}
    }
  </style>

  <div class="lm-container">
    <div class="lm-gallery__head" data-lm-reveal>
      <p class="lm-eyebrow lm-center">{{ section.settings.eyebrow | default: 'En images' }}</p>
      <h2 class="lm-title lm-title--lg lm-center">{{ section.settings.title | default: 'Une mise en scène à la hauteur du soin' }}</h2>
    </div>

    <div class="lm-gallery__grid">
      {% for block in section.blocks %}
        {%- assign style_key = block.settings.scene_style | default: 'white' -%}
        <div class="lm-gallery__cell" data-lm-reveal-scale {{ block.shopify_attributes }}>
          <div class="lm-scene lm-scene--{{ style_key }}">
            <div class="lm-scene__glow"></div>
            {% if style_key == 'leaf' %}
              <svg viewBox="0 0 200 200" width="46%" style="left:8%;top:10%;">
                <path d="M20 160 C10 90 60 20 150 15 C160 90 110 150 20 160 Z" fill="#B7C9A8" opacity=".55"/>
                <path d="M20 160 C60 120 110 70 150 15" stroke="#8FA37A" stroke-width="2" fill="none" opacity=".6"/>
              </svg>
            {% endif %}
            {% if block.settings.image_url != blank %}
              <img src="{{ block.settings.image_url }}" alt="{{ block.settings.caption | default: 'Luméa Skin' }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;display:block;">
            {% elsif block.settings.image %}
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,600,900', class: '', alt: block.settings.caption | default: 'Luméa Skin' }}
            {% else %}
              <svg class="lm-scene__bottle" viewBox="0 0 120 240"><use href="#lm-bottle"/></svg>
            {% endif %}
            <div class="lm-scene__shadow"></div>
            {% if block.settings.caption != blank %}
              <span class="lm-scene-caption">{{ block.settings.caption }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumea — Galerie premium",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "En images" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Une mise en scène à la hauteur du soin" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Photo mise en scène",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo (laisser vide pour un rendu placeholder premium)" },
        { "type": "url", "id": "image_url", "label": "URL photo (lien direct, prioritaire)" },
        {
          "type": "select",
          "id": "scene_style",
          "label": "Ambiance placeholder",
          "options": [
            { "value": "droplets", "label": "Gouttes d'eau" },
            { "value": "stone", "label": "Pierre naturelle" },
            { "value": "leaf", "label": "Feuille tropicale" },
            { "value": "white", "label": "Fond blanc luxueux" },
            { "value": "sunlight", "label": "Lumière du soleil" },
            { "value": "bath", "label": "Salle de bain moderne" },
            { "value": "reflection", "label": "Reflets sur l'eau" },
            { "value": "closeup", "label": "Gros plan packaging" }
          ],
          "default": "white"
        },
        { "type": "text", "id": "caption", "label": "Légende (optionnel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumea — Galerie premium",
      "blocks": [
        { "type": "scene", "settings": { "scene_style": "droplets", "caption": "Fraîcheur" } },
        { "type": "scene", "settings": { "scene_style": "stone", "caption": "Minéral" } },
        { "type": "scene", "settings": { "scene_style": "leaf", "caption": "Riz & botanique" } },
        { "type": "scene", "settings": { "scene_style": "sunlight", "caption": "Lumière naturelle" } },
        { "type": "scene", "settings": { "scene_style": "bath", "caption": "Rituel quotidien" } },
        { "type": "scene", "settings": { "scene_style": "reflection", "caption": "Éclat" } },
        { "type": "scene", "settings": { "scene_style": "closeup", "caption": "Le packaging" } }
      ]
    }
  ]
}
{% endschema %}
