<script>
(function(){
  if (window.__lumeaPremiumInit) return;
  window.__lumeaPremiumInit = true;

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function onIntersect(entries, obs){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        entry.target.classList.add('is-visible');
        obs.unobserve(entry.target);
      }
    });
  }

  function initReveal(){
    var targets = document.querySelectorAll('.lumea-premium [data-lm-reveal], .lumea-premium [data-lm-reveal-scale]');
    if (!targets.length) return;
    if (reduceMotion || !('IntersectionObserver' in window)){
      targets.forEach(function(el){ el.classList.add('is-visible'); });
      return;
    }
    var obs = new IntersectionObserver(onIntersect, { threshold: 0.16, rootMargin: '0px 0px -6% 0px' });
    targets.forEach(function(el){ obs.observe(el); });
  }

  function animateCount(el){
    var target = parseFloat(el.getAttribute('data-lm-count'));
    var decimals = (el.getAttribute('data-lm-count').split('.')[1] || '').length;
    var suffix = el.getAttribute('data-lm-count-suffix') || '';
    if (isNaN(target)) return;
    if (reduceMotion){ el.textContent = target.toFixed(decimals) + suffix; return; }
    var duration = 1300, start = null;
    function step(ts){
      if (!start) start = ts;
      var p = Math.min((ts - start) / duration, 1);
      var eased = 1 - Math.pow(1 - p, 3);
      el.textContent = (target * eased).toFixed(decimals) + suffix;
      if (p < 1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  }

  function initCounts(){
    var counts = document.querySelectorAll('.lumea-premium [data-lm-count]');
    if (!counts.length) return;
    if (!('IntersectionObserver' in window)){
      counts.forEach(animateCount);
      return;
    }
    var obs = new IntersectionObserver(function(entries, obs){
      entries.forEach(function(entry){
        if (entry.isIntersecting){ animateCount(entry.target); obs.unobserve(entry.target); }
      });
    }, { threshold: 0.5 });
    counts.forEach(function(el){ obs.observe(el); });
  }

  function initAccordions(){
    var items = document.querySelectorAll('.lumea-premium [data-lm-accordion-item]');
    items.forEach(function(item){
      var trigger = item.querySelector('[data-lm-accordion-trigger]');
      var panel = item.querySelector('[data-lm-accordion-panel]');
      if (!trigger || !panel) return;
      panel.style.overflow = 'hidden';
      panel.style.maxHeight = '0px';
      panel.style.transition = 'max-height .45s cubic-bezier(.22,.61,.36,1)';
      trigger.setAttribute('aria-expanded', 'false');
      trigger.addEventListener('click', function(){
        var isOpen = item.classList.contains('is-open');
        items.forEach(function(other){
          if (other !== item){
            other.classList.remove('is-open');
            var op = other.querySelector('[data-lm-accordion-panel]');
            var ot = other.querySelector('[data-lm-accordion-trigger]');
            if (op) op.style.maxHeight = '0px';
            if (ot) ot.setAttribute('aria-expanded', 'false');
          }
        });
        if (isOpen){
          item.classList.remove('is-open');
          panel.style.maxHeight = '0px';
          trigger.setAttribute('aria-expanded', 'false');
        } else {
          item.classList.add('is-open');
          panel.style.maxHeight = panel.scrollHeight + 'px';
          trigger.setAttribute('aria-expanded', 'true');
        }
      });
    });
  }

  function initBeforeAfter(){
    var sliders = document.querySelectorAll('.lumea-premium [data-lm-ba-range]');
    sliders.forEach(function(range){
      var wrap = range.closest('[data-lm-ba]');
      if (!wrap) return;
      var afterLayer = wrap.querySelector('[data-lm-ba-after]');
      var handle = wrap.querySelector('[data-lm-ba-handle]');
      function update(){
        var v = range.value;
        if (afterLayer) afterLayer.style.clipPath = 'inset(0 ' + (100 - v) + '% 0 0)';
        if (handle) handle.style.left = v + '%';
      }
      range.addEventListener('input', update);
      update();
    });
  }

  function init(){
    initReveal();
    initCounts();
    initAccordions();
    initBeforeAfter();
  }

  if (document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
