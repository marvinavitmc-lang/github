{% render 'lumea-styles' %}

<section class="lumea-premium lm-foot">
  <style>
    .lm-foot{background:var(--lm-ink);color:#EFE7DA;padding:76px 0 32px;}
    .lm-foot__top{display:grid;grid-template-columns:1fr;gap:44px;padding-bottom:52px;border-bottom:1px solid rgba(255,255,255,.12);}
    @media (min-width:820px){.lm-foot__top{grid-template-columns:1.3fr 1fr 1fr 1.2fr;gap:32px;}}
    .lm-foot__brand{font-family:'Fraunces',serif;font-size:1.7rem;margin:0 0 14px;color:#fff;}
    .lm-foot__tag{font-size:13.5px;line-height:1.7;color:rgba(239,231,218,.7);max-width:280px;font-weight:300;margin:0;}
    .lm-foot__heading{font-size:11.5px;text-transform:uppercase;letter-spacing:.12em;color:rgba(239,231,218,.55);margin:0 0 18px;}
    .lm-foot__links{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;}
    .lm-foot__links a{color:rgba(239,231,218,.85);text-decoration:none;font-size:14px;transition:color .25s;}
    .lm-foot__links a:hover{color:var(--lm-accent-soft);}
    .lm-newsletter-form{display:flex;gap:0;border-bottom:1px solid rgba(239,231,218,.4);padding-bottom:10px;margin-top:6px;}
    .lm-newsletter-form input[type="email"]{
      flex:1;background:none;border:0;color:#fff;font-size:14px;padding:8px 0;outline:none;font-family:'Public Sans',sans-serif;
    }
    .lm-newsletter-form input[type="email"]::placeholder{color:rgba(239,231,218,.5);}
    .lm-newsletter-form button{
      background:none;border:0;color:#fff;cursor:pointer;font-size:13px;font-weight:600;letter-spacing:.03em;
      display:flex;align-items:center;gap:6px;
    }
    .lm-foot__bottom{
      display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;padding-top:28px;
      font-size:12px;color:rgba(239,231,218,.55);
    }
    .lm-foot__socials{display:flex;gap:14px;}
    .lm-foot__socials a{color:rgba(239,231,218,.7);display:flex;}
  </style>

  <div class="lm-container">
    <div class="lm-foot__top" data-lm-reveal>
      <div>
        <p class="lm-foot__brand">{{ section.settings.brand_name | default: 'Luméa Skin' }}</p>
        <p class="lm-foot__tag">{{ section.settings.tagline | default: 'Des soins exfoliants visage et corps pensés pour une peau plus lisse, plus lumineuse, plus saine.' }}</p>
      </div>
      <div>
        <p class="lm-foot__heading">Boutique</p>
        <ul class="lm-foot__links">
          <li><a href="/products/peel-shot-acide-hypochloreux-au-riz">Peel Shot</a></li>
          <li><a href="/collections/all">Toute la boutique</a></li>
          <li><a href="/cart">Panier</a></li>
        </ul>
      </div>
      <div>
        <p class="lm-foot__heading">Assistance</p>
        <ul class="lm-foot__links">
          <li><a href="/pages/contact">Contact</a></li>
          <li><a href="/policies/refund-policy">Livraison &amp; retours</a></li>
          <li><a href="/policies/privacy-policy">Confidentialité</a></li>
        </ul>
      </div>
      <div>
        <p class="lm-foot__heading">{{ section.settings.newsletter_heading | default: 'Restez informée' }}</p>
        {% form 'customer' %}
          {% if form.posted_successfully? %}
            <p style="font-size:13px;color:#fff;">Merci, votre inscription est confirmée.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="lm-newsletter-form">
              <input type="email" name="contact[email]" placeholder="Votre email" required>
              <button type="submit">S'inscrire →</button>
            </div>
          {% endif %}
        {% endform %}
      </div>
    </div>

    <div class="lm-foot__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | default: 'Luméa Skin' }}. Tous droits réservés.</span>
      <div class="lm-foot__socials">
        {% for block in section.blocks %}
          <a href="{{ block.settings.url | default: '#' }}" aria-label="{{ block.settings.label }}" {{ block.shopify_attributes }}>
            {% case block.settings.icon %}
              {% when 'instagram' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1"/></svg>
              {% when 'tiktok' %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 3v11.5a3.5 3.5 0 11-3.5-3.5"/><path d="M14 3c.3 2.4 2 4 4.5 4.2"/></svg>
              {% else %}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
            {% endcase %}
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Lumea — Footer accueil",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Nom de marque", "default": "Luméa Skin" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Des soins exfoliants visage et corps pensés pour une peau plus lisse, plus lumineuse, plus saine." },
    { "type": "text", "id": "newsletter_heading", "label": "Titre newsletter", "default": "Restez informée" }
  ],
  "blocks": [
    {
      "type": "social",
      "name": "Réseau social",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "tiktok", "label": "TikTok" }
          ],
          "default": "instagram"
        },
        { "type": "url", "id": "url", "label": "Lien" },
        { "type": "text", "id": "label", "label": "Nom (accessibilité)", "default": "Instagram" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumea — Footer accueil",
      "blocks": [
        { "type": "social", "settings": { "icon": "instagram", "label": "Instagram" } },
        { "type": "social", "settings": { "icon": "tiktok", "label": "TikTok" } }
      ]
    }
  ]
}
{% endschema %}
